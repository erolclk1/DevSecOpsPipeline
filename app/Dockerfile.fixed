FROM node:22-alpine

WORKDIR /app

COPY package.fixed.json package-lock.fixed.json* ./

RUN npm ci --omit=dev \
    && npm audit fix --omit=dev || true

COPY server.js ./

ENV PORT=3000

EXPOSE 3000

# Run as the built-in non-root 'node' user (defense-in-depth; Scenario 2 is the "secure" build)
USER node

CMD ["node", "server.js"]